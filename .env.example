# HambakTech Smart Digital Platform - Environment Configuration Example
# Copy this file to .env.local for local frontend development or .env for backend configurations.
# NEVER commit sensitive production credentials or actual secret keys to the repository.

# Application Environment
APP_ENV=local
APP_NAME="HambakTech Smart Digital Platform"
APP_URL=http://localhost:3000

# Server-side Gemini API (Placeholder for future smart features)
GEMINI_API_KEY=

# Planned Future Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost/api

# Database Configuration (Prisma / PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/hambaktech_db?schema=public"

# Planned Legacy / cPanel Database Variables (Optional)
DB_CONNECTION=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hambaktech_db
DB_USERNAME=hambaktech_user
DB_PASSWORD=

# Planned Mail Configuration (cPanel SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mail.hambaktech.com.ng
MAIL_PORT=465
MAIL_USERNAME=info@hambaktech.com.ng
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@hambaktech.com.ng
MAIL_FROM_NAME="HambakTech & Services"

# Planned Payment Gateway Integrations (Placeholders)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=

REMITA_MERCHANT_ID=
REMITA_API_KEY=
REMITA_SERVICE_TYPE_ID=

# Planned Identity & Verification Service Providers (Placeholders)
NIN_PROVIDER_API_KEY=
BVN_PROVIDER_API_KEY=
CAC_PROVIDER_API_KEY=

# Planned Telecom VTU API Provider (Placeholders)
TELECOM_PROVIDER_API_KEY=
TELECOM_PROVIDER_SECRET=
