# ==============================================================================
# HAMBAKTECH & SERVICES — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env on the production server and populate the actual secrets.
# NEVER commit real credentials, secret keys, or passwords into source code.
# Sensitive server-side keys must NEVER be prefixed with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="HAMBAKTECH BUSINESS PLATFORM"
APP_ENV=production
APP_URL=https://business.hambaktech.com.ng
CORS_ALLOWED_ORIGINS=https://business.hambaktech.com.ng,https://www.business.hambaktech.com.ng
NEXT_PUBLIC_API_BASE_URL=https://business.hambaktech.com.ng

# ------------------------------------------------------------------------------
# 2. CANONICAL DATABASE CONFIGURATION (MySQL 8.0 / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hambakte_portal
DB_USERNAME=hambakte_dbuser
DB_PASSWORD=
DATABASE_URL=mysql://hambakte_dbuser:password@127.0.0.1:3306/hambakte_portal

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY: PAYSTACK (Real Production Keys)
# Webhook URL: https://hambaktech.com.ng/api/payments/webhook/paystack
# ------------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY: FLUTTERWAVE (Real Production Keys)
# Webhook URL: https://hambaktech.com.ng/api/payments/webhook/flutterwave
# ------------------------------------------------------------------------------
FLUTTERWAVE_PUBLIC_KEY=YOUR_FLUTTERWAVE_PUBLIC_KEY
FLUTTERWAVE_SECRET_KEY=YOUR_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_SECRET_HASH=your_custom_verif_hash_here
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY: REMITA (Production Remita Credentials)
# Webhook URL: https://hambaktech.com.ng/api/payments/webhook/remita
# Note: If unconfigured, platform reports BLOCKED — REMITA PRODUCTION CONFIGURATION REQUIRED.
# ------------------------------------------------------------------------------
REMITA_MERCHANT_ID=
REMITA_API_KEY=
REMITA_SERVICE_TYPE_ID=
REMITA_BASE_URL=https://remita.net/remita/exapp/api/v1/send/api

# ------------------------------------------------------------------------------
# 6. PAYMENT CHANNELS: MONIEPOINT & CORPORATE BANK TRANSFER (Manual Workflow)
# Details displayed to customer during manual transfer initialization.
# ------------------------------------------------------------------------------
MONIEPOINT_BANK_NAME="Moniepoint Microfinance Bank"
MONIEPOINT_ACCOUNT_NUMBER=
MONIEPOINT_ACCOUNT_NAME="HAMBAKTECH & SERVICES"
MONIEPOINT_API_KEY=
MONIEPOINT_SECRET_KEY=

CORPORATE_BANK_NAME="First Bank of Nigeria"
CORPORATE_BANK_ACCOUNT=
CORPORATE_BANK_ACCOUNT_NAME="HAMBAKTECH & SERVICES"

# ------------------------------------------------------------------------------
# 7. GOVERNMENT IDENTITY: NIN & BVN PROVIDERS
# Note: If provider contract/credentials are unconfigured, platform reports
# BLOCKED — NIN/BVN PROVIDER CONTRACT REQUIRED.
# ------------------------------------------------------------------------------
NIN_PROVIDER_NAME=
NIN_PROVIDER_ENDPOINT=
NIN_PROVIDER_API_KEY=
NIN_PROVIDER_SECRET=

BVN_PROVIDER_NAME=
BVN_PROVIDER_ENDPOINT=
BVN_PROVIDER_API_KEY=
BVN_PROVIDER_SECRET=

CAC_PROVIDER_API_KEY=

# ------------------------------------------------------------------------------
# 8. TELECOM & IDENTITY PROVIDERS (Veripine, VTpass, VTU.ng)
# All provider credentials are strictly server-side and never exposed to client.
# ------------------------------------------------------------------------------
VERIPINE_BASE_URL=https://www.veripine.com/api
VERIPINE_API_KEY=

VTPASS_LIVE=false
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

VTU_NG_USERNAME=
VTU_NG_PASSWORD=
VTU_NG_USER_PIN=

TELECOM_PROVIDER_API_KEY=
TELECOM_PROVIDER_SECRET=

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAIL (cPanel / SMTP / Amazon SES)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.hambaktech.com.ng
MAIL_PORT=465
MAIL_USERNAME=support@hambaktech.com.ng
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=support@hambaktech.com.ng
MAIL_FROM_NAME="HAMBAKTECH & SERVICES"
