# ==============================================================================
# HAMBAKTECH SMART DIGITAL PLATFORM v1.0 — CPANEL PRODUCTION CONFIGURATION
# Copy this file to .env in your application root on Truehost cPanel.
# Set appropriate file permissions: chmod 600 .env
# ==============================================================================

# Application Identity & Base URLs
APP_NAME="HAMBAKTECH BUSINESS PLATFORM"
APP_ENV=production
APP_URL=https://business.hambaktech.com.ng
NEXT_PUBLIC_APP_URL=https://business.hambaktech.com.ng
NEXT_PUBLIC_API_BASE_URL=https://business.hambaktech.com.ng

# Production Database (cPanel MySQL / MariaDB)
# Replace with the exact database credentials created in cPanel MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hambakte_portal
DB_DATABASE=hambakte_portal
DB_USER=hambakte_dbuser
DB_USERNAME=hambakte_dbuser
DB_PASSWORD=YOUR_CPANEL_MYSQL_PASSWORD
DATABASE_URL=mysql://hambakte_dbuser:YOUR_CPANEL_MYSQL_PASSWORD@127.0.0.1:3306/hambakte_portal

# Cryptographic Keys (Generate using: openssl rand -hex 32)
JWT_SECRET=GENERATE_64_CHAR_RANDOM_HEX_SECRET_FOR_JWT
APP_KEY=GENERATE_64_CHAR_RANDOM_HEX_KEY_FOR_APP_SECURITY

# Session Security
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=true

# cPanel SMTP Mail Configuration
# Created via cPanel Email Accounts (support@hambaktech.com.ng)
MAIL_MAILER=smtp
MAIL_HOST=mail.hambaktech.com.ng
SMTP_HOST=mail.hambaktech.com.ng
MAIL_PORT=465
SMTP_PORT=465
MAIL_USERNAME=support@hambaktech.com.ng
SMTP_USER=support@hambaktech.com.ng
MAIL_PASSWORD=YOUR_CPANEL_EMAIL_ACCOUNT_PASSWORD
SMTP_PASSWORD=YOUR_CPANEL_EMAIL_ACCOUNT_PASSWORD
MAIL_ENCRYPTION=ssl
SMTP_SECURE=ssl
MAIL_FROM_ADDRESS=support@hambaktech.com.ng
SMTP_FROM_EMAIL=support@hambaktech.com.ng
SMTP_FROM=support@hambaktech.com.ng
MAIL_FROM_NAME="HAMBAKTECH & SERVICES"
SMTP_FROM_NAME="HAMBAKTECH & SERVICES"
SMTP_REPLY_TO=support@hambaktech.com.ng
ADMIN_ALERT_EMAIL=admin@hambaktech.com.ng
SUPPORT_NOTIFY_EMAIL=support@hambaktech.com.ng

# Storage Configuration
STORAGE_PROVIDER=local
MAX_UPLOAD_BYTES=5242880

# Payment Gateways (Live Production Keys)
DEFAULT_PAYMENT_PROVIDER=PAYSTACK

# Paystack (Webhook: https://hambaktech.com.ng/api/payments/webhook/paystack)
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY

# Flutterwave (Webhook: https://hambaktech.com.ng/api/payments/webhook/flutterwave)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-YOUR_FLUTTERWAVE_PUBLIC_KEY
FLUTTERWAVE_SECRET_KEY=FLWSECK-YOUR_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_SECRET_HASH=YOUR_FLUTTERWAVE_WEBHOOK_SECRET_HASH

# Remita (Webhook: https://hambaktech.com.ng/api/payments/webhook/remita)
REMITA_MERCHANT_ID=YOUR_REMITA_MERCHANT_ID
REMITA_API_KEY=YOUR_REMITA_API_KEY
REMITA_SERVICE_TYPE_ID=YOUR_REMITA_SERVICE_TYPE_ID
REMITA_BASE_URL=https://remita.net/remita/exapp/api/v1/send/api

# Manual Bank Transfer Accounts (Displayed on customer funding screen)
MONIEPOINT_BANK_NAME="Moniepoint Microfinance Bank"
MONIEPOINT_ACCOUNT_NUMBER=YOUR_MONIEPOINT_ACCOUNT_NUMBER
MONIEPOINT_ACCOUNT_NAME="HAMBAKTECH & SERVICES"

CORPORATE_BANK_NAME="First Bank of Nigeria"
CORPORATE_BANK_ACCOUNT=YOUR_FIRST_BANK_ACCOUNT_NUMBER
CORPORATE_BANK_ACCOUNT_NAME="HAMBAKTECH & SERVICES"

# Veripine Identity Gateway (NIN & BVN)
VERIPINE_BASE_URL=https://www.veripine.com/api
VERIPINE_API_KEY=YOUR_VERIPINE_API_KEY

# VTpass Telecom Gateway (Airtime, Data, Electricity, TV)
VTPASS_LIVE=true
VTPASS_API_KEY=YOUR_VTPASS_API_KEY
VTPASS_PUBLIC_KEY=YOUR_VTPASS_PUBLIC_KEY
VTPASS_SECRET_KEY=YOUR_VTPASS_SECRET_KEY

# VTU.ng Telecom Gateway (Airtime, Data, Electricity, TV, Webhook)
# Webhook URL: https://hambaktech.com.ng/api/telecom/webhook/vtung
VTU_NG_USERNAME=YOUR_VTU_NG_USERNAME
VTU_NG_PASSWORD=YOUR_VTU_NG_PASSWORD
VTU_NG_USER_PIN=YOUR_VTU_NG_USER_PIN

# Security & CORS
CORS_ALLOWED_ORIGINS=https://hambaktech.com.ng,https://www.hambaktech.com.ng
LOG_LEVEL=INFO
LOG_STORAGE_PATH=storage/logs/hambaktech.log
